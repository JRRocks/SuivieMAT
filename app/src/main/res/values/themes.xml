<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme minimal : la palette reelle est definie en Compose (ui/theme). -->
    <style name="Theme.ScanList" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- Pas d'animation d'ouverture ni de fermeture de fenetre : tout est instantane. -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
