    <!-- Aide-memoire regex, ouvert depuis "Formule regex" et "Formules enregistrees" -->
    <string name="regex_help_button">Aide sur les formules regex</string>
    <string name="regex_help_title">Formules regex</string>
    <string name="regex_help_intro">C\'est un outil ultra-puissant pour éviter les faux positifs, mais complexe à écrire à la main. Le plus simple ? Demande directement à un LLM (comme ChatGPT) de le générer pour toi, en lui donnant une liste des valeurs que tu cherches à capturer !</string>

    <string name="regex_help_prompt_label">Prompt à copier</string>
    <!-- Texte reellement copie : sans les points de suspension, qui ne servent qu'a
         montrer a l'ecran que la phrase reste a completer. L'espace final est
         significatif (la liste de valeurs vient juste apres) : entoure de guillemets
         pour que le compilateur de ressources ne le supprime pas comme un espace de
         bord ordinaire. -->
    <string name="regex_help_prompt_template">"Génère-moi un pattern REGEX pour "</string>
    <string name="regex_help_prompt_copied">Prompt copié</string>

    <string name="regex_help_example_title">Exemple pour : %1$s</string>
    <string name="regex_help_example_desc">2 chiffres, un tiret, 6 chiffres</string>
    <string name="regex_help_example_pattern_label">En regex : %1$s</string>
    <string name="regex_help_example_pattern">\\b\\d{2}-\\d{6}\\b</string>

